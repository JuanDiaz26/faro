# Variables de entorno de Faro

# Ruta donde se guarda la base SQLite.
# En Railway, montá un volumen en /data y poné DB_PATH=/data/finanzas.db
# para que los datos sobrevivan a redeploys.
# Local: dejá vacío (usa server/db/finanzas.db por default).
DB_PATH=

# Puerto en que escucha Express. Railway lo inyecta automáticamente.
PORT=3000
